              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List all non-archived agents for the project (paginated)"
        },
        {
          "info": {
            "name": "postApiAgents",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.langwatch.ai/api/agents",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new agent"
        },
        {
          "info": {
            "name": "getApiAgentsById",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.langwatch.ai/api/agents/:id",
