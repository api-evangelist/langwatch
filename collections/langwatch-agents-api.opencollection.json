              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get an agent by its id"
        },
        {
          "info": {
            "name": "patchApiAgentsById",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://app.langwatch.ai/api/agents/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an agent by its id"
        },
        {
          "info": {
            "name": "deleteApiAgentsById",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.langwatch.ai/api/agents/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Archive an agent (soft-delete)"
        }
      ]
    }
  ],
  "bundled": true
}