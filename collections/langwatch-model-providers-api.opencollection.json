{
  "opencollection": "1.0.0",
  "info": {
    "name": "LangWatch Agents Model Providers API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Auth-Token",
      "value": "{{X-Auth-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Model Providers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "getApiModel-providers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.langwatch.ai/api/model-providers"
          },
          "docs": "List all model providers for a project with masked API keys"
        },
        {
          "info": {
            "name": "putApiModel-providersByProvider",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://app.langwatch.ai/api/model-providers/:provider",
            "params": [
              {
                "name": "provider",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create or update a model provider"
        }
      ]
    }
  ],
  "bundled": true
}