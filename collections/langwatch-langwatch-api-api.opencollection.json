{
  "opencollection": "1.0.0",
  "info": {
    "name": "LangWatch Agents LangWatch API API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Auth-Token",
      "value": "{{X-Auth-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "LangWatch API",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "getIndex",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.langwatch.ai/"
          },
          "docs": "Get all prompts for a project"
        },
        {
          "info": {
            "name": "postIndex",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.langwatch.ai/",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new prompt with default initial version"
        }
      ]
    }
  ],
  "bundled": true
}